  "proposed_flow": [
    {
      "order": 1,
      "stage": "Student Landing",
      "purpose": "Enter STEM Nation"
    },
    {
      "order": 2,
      "stage": "Academy Opening",
      "purpose": "Establish mission and inquiry identity"
    },
    {
      "order": 3,
      "stage": "Create Academy Identity",
      "purpose": "Create learner identity"
    },
    {
      "order": 4,
      "stage": "Opening Cinematic",
      "purpose": "Enter the Academy world"
    },
    {
      "order": 5,
      "stage": "Academy Arrival",
      "purpose": "Physical and narrative arrival"
    },
    {
      "order": 6,
      "stage": "First Gathering",
      "purpose": "Brief handoff into the investigation"
    },
    {
      "order": 7,
      "stage": "Inquiry Council",
      "purpose": "Introduce Scout, Mapkeeper, Builder, Healer, and Guardian"
    },
    {
      "order": 8,
      "stage": "Sector 7A Alert",
      "purpose": "Establish one continuous incident"
    },
    {
      "order": 9,
      "stage": "Earlier / Current Evidence",
      "purpose": "Observe and compare before interpretation"
    },
    {
      "order": 10,
      "stage": "Question Ranking",
      "purpose": "Choose and defend the three most important questions"
    },
    {
      "order": 11,
      "stage": "Sector 7A Field Response",
      "purpose": "Replace unrelated crossing narrative with Sector 7A access challenge"
    },
    {
      "order": 12,
      "stage": "Test and Revise",
      "purpose": "Use evidence, materials, and specialist reports"
    },
    {
      "order": 13,
      "stage": "Sector 7A Debrief",
      "purpose": "Defend decision and record readiness progress"
    },
    {
      "order": 14,
      "stage": "Academy Progress Hub",
      "purpose": "Return learner to a clear completion point"
    },
    {
      "order": 15,
      "stage": "Later Legacy Council Module",
      "purpose": "Introduce Dr. and Mrs. Mishoe in a separate institutional/legacy context"
    },
    {
      "order": 16,
      "stage": "Later World Orientation",
      "purpose": "Teach regions, terrain, resources, and responsibilities"
    },
    {
      "order": 17,
      "stage": "Later Region Selection",
      "purpose": "Choose a region after orientation and readiness"
    }
  ]
}