{
  "version": "VIS-1",
  "title": "STEM Nation Visual Experience Layer",
  "purpose": "Central registry for images, animation classes, cartoon scenes, advisor states, and mission visuals.",
  "style_lock": {
    "tone": "cinematic classroom adventure",
    "look": "warm cartoon realism",
    "student_age_fit": "upper elementary through middle school",
    "rules": [
      "Visuals support inquiry; they do not replace thinking.",
      "Student identity remains separate from Inquiry Council advisors.",
      "Council advisors guide the learner; students do not become advisor roles.",
      "Animation should clarify progress, consequence, and reflection.",
      "Avoid clutter, overstimulation, or childish decoration."
    ]
  },
  "council_advisors": {
    "scout": {
      "verb": "Discover",
      "question": "What do we notice?",
      "states": [
        "neutral",
        "observing",
        "concerned",
        "excited"
      ]
    },
    "mapkeeper": {
      "verb": "Remember",
      "question": "What do we know?",
      "states": [
        "neutral",
        "remembering",
        "warning",
        "confirming"
      ]
    },
    "builder": {
      "verb": "Create",
      "question": "What can we build?",
      "states": [
        "neutral",
        "planning",
        "testing",
        "celebrating"
      ]
    },
    "healer": {
      "verb": "Restore",
      "question": "What do people need?",
      "states": [
        "neutral",
        "worried",
        "caring",
        "restored"
      ]
    },
    "guardian": {
      "verb": "Protect",
      "question": "What should we protect?",
      "states": [
        "neutral",
        "alert",
        "protective",
        "approving"
      ]
    }
